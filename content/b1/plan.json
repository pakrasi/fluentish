 "traps": [
  {
   "id": "verb-final",
   "name": "Verb at the end after dass, weil, wenn, ob",
   "hint": "Check where the verb goes after {S}.",
   "rule": "After dass, the verb goes to the end: …, dass das eine gute Idee ist.",
   "wrong_example": "Ich glaube, dass das ist eine gute Idee."
  },
  {
   "id": "v2",
   "name": "Verb second after a fronted phrase",
   "hint": "Check the word order after {X}.",
   "rule": "After Am Ende, the verb comes next, then the subject: Am Ende machen wir eine Party.",
   "wrong_example": "Am Ende, wir machen eine Party.",
   "fronted": [
    "am ende",
    "am anfang",
    "leider",
    "deshalb",
    "deswegen",
    "darum",
    "dann",
    "danach",
    "zuerst",
    "zuletzt",
    "schließlich",
    "heute",
    "morgen",
    "gestern",
    "jetzt",
    "trotzdem",
    "außerdem",
    "vielleicht",
    "natürlich",
    "meiner meinung nach",
    "zum schluss",
    "in meinem heimatland",
    "bei uns",
    "seitdem",
    "inzwischen",
    "früher",
    "am wochenende",
    "am samstag",
    "am sonntag",
    "am montag",
    "am freitag",
    "im sommer",
    "im winter",
    "vor zwei jahren",
    "aus diesem grund",
    "auf der einen seite",
    "auf der anderen seite",
    "tatsächlich",
    "eigentlich",
    "zum glück",
    "normalerweise",
    "letztes jahr",
    "letzte woche",
    "nächste woche",
    "einerseits",
    "andererseits",
    "manchmal",
    "meistens",
    "oft",
    "im moment",
    "zurzeit",
    "dafür",
    "dagegen",
    "allerdings",
    "sonst"
   ],
   "note": "A comma after Leider or Aber is a Hard-level note, not a miss. After the comma_ok words (Natürlich, …) a comma starts a new clause, so no hint.",
   "comma_ok": [
    "natürlich",
    "vielleicht",
    "allerdings"
   ]
  },
  {
   "id": "fuer-vor",
   "name": "für or vor",
   "hint": "Check the preposition after {prev}.",
   "rule": "Angst vor, warnen vor, sich schämen vor: fear and warning take vor.",
   "wrong_example": "Ich habe Angst für der Prüfung."
  },
  {
   "id": "cap",
   "name": "Noun capitals",
   "hint": "Check the capital letters.",
   "rule": "Nouns take a capital, including made-up ones: etwas Neues, das Lernen.",
   "wrong_example": "Ich habe etwas neues gelernt."
  },
  {
   "id": "neuter",
   "name": "Neuter -ma nouns and nouns made from verbs",
   "hint": "Check the article on {Noun}.",
   "rule": "Nouns ending in -ma are neuter: das Thema, das Problem.",
   "wrong_example": "Der Thema ist interessant."
  }
 ],
