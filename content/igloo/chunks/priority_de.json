  {
   "function": "Open the presentation with the topic",
   "part": "Sprechen T2",
   "de": "Ich möchte heute über das Thema „[Thema]“ sprechen.",
   "en": "Today I would like to talk about the topic \"[topic]\"."
  },
  {
   "function": "Say the topic is much discussed",
   "part": "Sprechen T2",
   "de": "Über dieses Thema wird heute viel diskutiert.",
   "en": "This topic is much discussed today."
  },
  {
   "function": "Announce the structure",
   "part": "Sprechen T2",
   "de": "Meine Präsentation besteht aus [Zahl] Teilen.",
   "en": "My presentation has [number] parts."
  },
  {
   "function": "Introduce your own experience",
   "part": "Sprechen T2",
   "de": "Aus eigener Erfahrung kann ich sagen, dass [Satz]",
   "en": "From my own experience I can say that [clause]"
  },
  {
   "function": "Describe the home country",
   "part": "Sprechen T2",
   "de": "In meinem Heimatland ist es so, dass [Satz]",
   "en": "In my home country it is the case that [clause]"
  },
  {
   "function": "Name an advantage",
   "part": "Sprechen T2",
   "de": "Ein Vorteil ist, dass [Satz] / Dafür spricht, dass [Satz]",
   "en": "One advantage is that [clause] / In favour of it is that [clause]"
  },
  {
   "function": "Name a disadvantage",
   "part": "Sprechen T2",
   "de": "Ein Nachteil ist allerdings, dass [Satz] / Dagegen spricht, dass [Satz]",
   "en": "One disadvantage, however, is that [clause] / Against it is that [clause]"
  },
  {
   "function": "Draw the conclusion",
   "part": "Sprechen T2",
   "de": "Deshalb komme ich zu dem Schluss, dass [Satz]",
   "en": "That is why I come to the conclusion that [clause]"
  },
  {
   "function": "Sum up",
   "part": "Forum",
   "de": "Zusammenfassend kann man sagen, dass [Satz]",
   "en": "In summary one can say that [clause]"
  },
  {
   "function": "End the presentation",
   "part": "Sprechen T2",
   "de": "Damit bin ich am Ende meiner Präsentation. Vielen Dank für Ihre Aufmerksamkeit.",
   "en": "That brings me to the end of my presentation. Thank you for your attention."
  },
  {
   "function": "State a firm opinion",
   "part": "Forum",
   "de": "Ich bin der Meinung / der Ansicht, dass [Satz]",
   "en": "I am of the opinion that [clause]"
  },
  {
   "function": "State a conviction",
   "part": "Forum",
   "de": "Ich bin davon überzeugt, dass [Satz]",
   "en": "I am convinced that [clause]"
  },
  {
   "function": "Open a forum post",
   "part": "Forum",
   "de": "Ich finde das Thema sehr interessant, weil [Satz]",
   "en": "I find the topic very interesting because [clause]"
  },
  {
   "function": "Close a forum post",
   "part": "Forum",
   "de": "Das ist meine Meinung.",
   "en": "That is my opinion."
  },
  {
   "function": "Suggest with a dass-clause",
   "part": "Sprechen T1",
   "de": "Ich schlage vor, dass wir [Satz]",
   "en": "I suggest that we [clause]"
  },
  {
   "function": "Suggest with wenn",
   "part": "Sprechen T1",
   "de": "Wie wäre es, wenn wir [Satz]?",
   "en": "How about if we [clause]?"
  },
  {
   "function": "Soft no: good idea, but",
   "part": "Sprechen T1",
   "de": "Das ist zwar eine gute Idee, aber [Satz]",
   "en": "That is a good idea, but [clause]"
  },
  {
   "function": "Agree on a point",
   "part": "Sprechen T1",
   "de": "Einverstanden! / Abgemacht! / Okay, dann machen wir das so.",
   "en": "Agreed! / Deal! / Okay, then let's do it that way."
