{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "b1-schreiben@1",
  "title": "Goethe B1 Schreiben practice",
  "description": "Schreiben phrase items (BS: ids, area writing), the functions they are grouped by in each Aufgabe, the B1 trainer's letter items filed under those functions (linked), and the Build an email tasks. Built from authoring/schreiben-src by tools/build_schreiben.py. Item ids are stable: progress is stored under them.",
  "type": "object",
  "required": ["aufgaben", "functions", "items", "linked", "tasks"],
  "additionalProperties": false,
  "$defs": {
    "punct": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(comma-end|no-comma-end|lower-start|comma-before:[a-zäöüß]+)$" }
    },
    "patterns": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1 } },
    "words": { "type": "array", "items": { "type": "string" } },
    "aufgabe": { "enum": ["A1", "A2", "A3"] }
  },
  "properties": {
    "about": { "type": "string" },
    "aufgaben": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "required": ["id", "teil", "name", "short", "words", "minutes", "register", "about"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/aufgabe" }, "teil": { "enum": ["W1", "W2", "W3"] }, "name": { "type": "string" }, "short": { "type": "string" },
          "words": { "type": "integer", "minimum": 1 }, "minutes": { "type": "integer", "minimum": 1 }, "register": { "enum": ["du", "Sie", "none"] },
          "about": { "type": "string" }
        }
      }
    },
    "functions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "aufgabe", "name", "n"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^a[123]_[a-z]+$" }, "aufgabe": { "$ref": "#/$defs/aufgabe" }, "name": { "type": "string" },
          "n": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "area", "group", "teil", "aufgabe", "fn", "star", "tier", "rank", "prompt", "prompt_lang", "hl", "accept", "anywhere", "model", "wrong", "rule", "punct", "src"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^BS:a[123]-[a-z0-9-]+$" },
          "kind": { "const": "phrase" },
          "area": { "const": "writing" },
          "group": { "enum": ["W1", "W2", "W3"] },
          "teil": { "enum": ["W1", "W2", "W3"] },
          "aufgabe": { "$ref": "#/$defs/aufgabe" },
          "fn": { "type": "string", "pattern": "^a[123]_[a-z]+$" },
          "star": { "type": "boolean" },
          "tier": { "enum": [1, 2, 3] },
          "rank": { "type": "integer", "minimum": 1 },
          "trap": { "type": ["string", "null"] },
          "focus": { "$ref": "#/$defs/words" },
          "strict": { "$ref": "#/$defs/words" },
          "plan": { "const": "recall" },
          "task": { "type": ["string", "null"] },
          "prompt": { "type": "string", "minLength": 1 },
          "prompt_lang": { "const": "en" },
          "hl": { "type": "string", "minLength": 1 },
          "partner": { "type": "null" },
          "prefill": { "type": "null" },
          "accept": { "$ref": "#/$defs/patterns" },
          "anywhere": { "const": true },
          "model": { "type": "string", "minLength": 1 },
          "wrong": { "$ref": "#/$defs/words" },
          "rule": { "type": "string", "minLength": 1 },
          "punct": { "$ref": "#/$defs/punct" },
          "src": { "const": "schreiben" },
          "chunk": { "type": "null" },
          "level": { "enum": ["A1", "A2", "B1", "B2"] }
        }
      }
    },
    "linked": {
      "type": "object",
      "propertyNames": { "pattern": "^BP:w[123]-[a-z0-9-]+$" },
      "additionalProperties": {
        "type": "object", "required": ["fn", "rank"], "additionalProperties": false,
        "properties": { "fn": { "type": "string", "pattern": "^a[123]_[a-z]+$" }, "rank": { "type": "integer", "minimum": 1 } }
      }
    },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "aufgabe", "to", "title", "situation", "points", "parts"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^a[123]-[a-z0-9-]+$" },
          "aufgabe": { "$ref": "#/$defs/aufgabe" },
          "exam": {
            "type": "object", "required": ["test", "aufgabe"], "additionalProperties": false,
            "properties": { "test": { "type": "integer", "minimum": 1 }, "aufgabe": { "enum": ["aufgabe1", "aufgabe2", "aufgabe3"] } }
          },
          "to": { "type": "string" }, "title": { "type": "string" }, "situation": { "type": "string" }, "quote": { "type": "string" },
          "points": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "type": "string" } },
          "parts": {
            "type": "array", "minItems": 3,
            "items": {
              "type": "object", "required": ["key", "kind", "cue", "model", "accept", "rule", "point", "lower", "frame", "glue", "trap", "focus", "strict", "punct", "wrong"],
              "additionalProperties": false,
              "properties": {
                "key": { "type": "string", "pattern": "^(open|intro|p[1-5]|close|sign)$" },
                "kind": { "enum": ["fixed", "free"] },
                "point": { "type": ["integer", "null"], "minimum": 1 },
                "lower": { "type": "boolean" },
                "frame": { "type": ["string", "null"] },
                "glue": { "$ref": "#/$defs/words" },
                "cue": { "type": "string", "minLength": 1 },
                "model": { "type": "string", "minLength": 1 },
                "accept": { "$ref": "#/$defs/patterns" },
                "wrong": { "$ref": "#/$defs/words" },
                "trap": { "type": ["string", "null"] },
                "focus": { "$ref": "#/$defs/words" },
                "strict": { "$ref": "#/$defs/words" },
                "punct": { "$ref": "#/$defs/punct" },
                "rule": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
