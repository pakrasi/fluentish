{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trainer-annot@1",
  "title": "B1 annotations of Igloo grammar items",
  "description": "Keyed by 'G:<grammar item id>': topic, trap, focus and wrong answers the B1 trainer adds to an existing Igloo grammar item.",
  "type": "object",
  "propertyNames": {
    "pattern": "^G:"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "topic": {
        "type": [
          "string",
          "null"
        ]
      },
      "trap": {
        "type": [
          "string",
          "null"
        ]
      },
      "focus": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "strict": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "wrong": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "rule": {
        "type": [
          "string",
          "null"
        ]
      },
      "skip": {
        "type": "boolean"
      }
    }
  }
}
