{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lexicon@1",
  "title": "Word list (one language)",
  "description": "Words A1–C2 of one language with article, plural, meanings, level, theme, frequency and an example (German: igloo.words.de; French: igloo.words.fr, with gender, verb forms and auxiliary). Ids are stable: progress is stored under them.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "w",
      "pos",
      "en",
      "level"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "w": {
        "type": "string"
      },
      "art": {
        "type": [
          "string",
          "null"
        ]
      },
      "pl": {
        "type": [
          "string",
          "null"
        ]
      },
      "pos": {
        "type": "string"
      },
      "en": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "alt": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "level": {
        "enum": [
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2"
        ]
      },
      "theme": {
        "type": [
          "string",
          "null"
        ]
      },
      "rank": {
        "type": "integer"
      },
      "zipf": {
        "type": [
          "number",
          "null"
        ]
      },
      "ex": {
        "type": [
          "string",
          "null"
        ]
      },
      "exen": {
        "type": [
          "string",
          "null"
        ]
      },
      "reviewedBy": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "description": "Native review (C3a): the reviewer's handle (never a real name; the repository is public)."
      },
      "reviewedAt": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Native review: the day it was reviewed (YYYY-MM-DD). Set together with reviewedBy."
      },
      "g": {
        "enum": [
          "m",
          "f",
          null
        ],
        "description": "Grammatical gender where the article hides it (French l'); French nouns carry it always."
      },
      "forms": {
        "type": "string"
      },
      "aux": {
        "enum": [
          "avoir",
          "être"
        ],
        "description": "French: the passé composé's auxiliary."
      },
      "pp": {
        "type": "string",
        "description": "French: the past participle."
      },
      "note": {
        "type": "string"
      },
      "fem": {
        "type": "string",
        "description": "French adjectives: the feminine."
      },
      "before": {
        "type": "boolean",
        "description": "French adjectives: goes before the noun."
      },
      "dom": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "work",
            "economy",
            "news",
            "politics",
            "science",
            "tech",
            "health",
            "environment",
            "society",
            "general"
          ]
        },
        "description": "Subject domains of a B2 or C1 word (round 4): where a learner meets it in news, work and public life. 'general' stands alone."
      }
    }
  }
}
