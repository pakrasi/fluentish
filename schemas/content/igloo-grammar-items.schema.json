{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grammar@1",
  "title": "German grammar items",
  "description": "Typed grammar items per concept. tools/validate_grammar.py checks counts per concept and level.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "concept",
      "level",
      "kind",
      "task",
      "prompt",
      "answer",
      "note",
      "strict_case"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.\\d{2}$"
      },
      "concept": {
        "type": "string"
      },
      "level": {
        "enum": [
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2"
        ]
      },
      "kind": {
        "enum": [
          "transform",
          "gap",
          "join",
          "choose-article",
          "order",
          "translate"
        ]
      },
      "task": {
        "type": "string"
      },
      "prompt": {
        "type": "string"
      },
      "answer": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "note": {
        "type": "string"
      },
      "strict_case": {
        "type": "boolean"
      },
      "reviewedBy": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "description": "Native review (C3a): the reviewer's handle (never a real name; the repository is public)."
      },
      "reviewedAt": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Native review: the day it was reviewed (YYYY-MM-DD). Set together with reviewedBy."
      },
      "layer": {
        "enum": [
          "b2"
        ],
        "description": "The B2 layer (round 4): a B2 item outside the B1 trainer. The B1 pool, readiness and priorityLeft never count it (tools/b2.mjs)."
      }
    }
  }
}
