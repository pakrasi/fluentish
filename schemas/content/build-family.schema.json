{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "build-family@1",
  "title": "Word family (one root)",
  "description": "content/build/family/<slug>.json: one word family, exactly one entry of what was families[] in content/build/de.json (content/build/FAMILY-SCHEMA.md). Built by tools/build-wordbuild.mjs from authoring/build/families/<root>.json; the rules a schema cannot say are in src/domain/wordbuild-family-check.js, run on the merged content.",
  "$defs": {"id": {"type": "string", "pattern": "^[a-zäöüß][a-zäöüß-]*$"}, "text": {"type": "string", "minLength": 1, "pattern": "^[^—–]*$"}, "level": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]}, "tiles": {"type": "array", "minItems": 2, "items": {"type": "array", "prefixItems": [{"enum": ["S", "X", "O", "A", "N", "C", "R", "P", "G", "Z", "."]}, {"$ref": "#/$defs/text"}], "minItems": 2, "maxItems": 2}}},
  "type": "object",
  "required": ["root", "lemma", "en", "pres3", "pret", "aux", "pp", "level", "stems", "forms", "boards", "none", "rare"],
  "additionalProperties": false,
  "properties": {"root": {"$ref": "#/$defs/id"}, "lemma": {"type": "string", "minLength": 1}, "en": {"$ref": "#/$defs/text"}, "pres3": {"$ref": "#/$defs/text"}, "pret": {"$ref": "#/$defs/text"}, "aux": {"enum": ["hat", "ist", "hat/ist"]}, "pp": {"$ref": "#/$defs/text"}, "level": {"$ref": "#/$defs/level"}, "zipf": {"type": ["number", "null"]}, "stems": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "forms": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "card", "word", "cls", "parent", "pre", "suf", "key", "seg", "stress", "en", "ex", "exEn", "grade", "how", "level", "lemma", "lex", "board"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^[\\p{L}_.-]+$"}, "card": {"type": ["string", "null"], "pattern": "^P[VWF]:."}, "word": {"type": "string", "pattern": "^[A-Za-zÄÖÜäöüß]+$"}, "cls": {"enum": ["verb", "noun", "adj", "adv", "conj", "prep"]}, "art": {"enum": ["der", "die", "das"]}, "artBy": {"enum": ["ending", "usual", "except"]}, "adjNoun": {"type": "boolean"}, "pl": {"type": "boolean"}, "kind": {"enum": ["s", "i"]}, "refl": {"type": "boolean"}, "aux": {"enum": ["hat", "ist", "hat/ist"]}, "pp": {"type": "string", "pattern": "^[a-zäöüß]+$"}, "parent": {"type": ["string", "null"]}, "add": {"type": "string", "minLength": 1}, "side": {"enum": ["pre", "suf", "cmp"]}, "pre": {"type": "array", "items": {"type": "string"}}, "suf": {"type": "array", "items": {"type": "string"}}, "key": {"type": ["string", "null"]}, "seg": {"type": "array", "minItems": 1, "items": {"type": "array", "prefixItems": [{"enum": ["p", "r", "s", "i", "c", "l"]}, {"type": "string", "minLength": 1}], "minItems": 2, "maxItems": 2}}, "stress": {"type": "integer", "minimum": 0}, "en": {"$ref": "#/$defs/text"}, "clue": {"$ref": "#/$defs/text"}, "ex": {"$ref": "#/$defs/text"}, "exEn": {"$ref": "#/$defs/text"}, "why": {"$ref": "#/$defs/text"}, "note": {"$ref": "#/$defs/text"}, "grade": {"enum": ["T", "M", "O"]}, "how": {"enum": ["lit", "pic", "hist", "word"]}, "level": {"$ref": "#/$defs/level"}, "zipf": {"type": ["number", "null"]}, "rare": {"type": "boolean"}, "board": {"type": "boolean"}, "lemma": {"type": ["string", "null"]}, "lex": {"type": "array", "items": {"enum": ["list", "dwds", "corpus", "wf"]}}, "src": {"$ref": "#/$defs/text"}, "ppWhy": {"$ref": "#/$defs/text"}}}}, "boards": {"type": "object", "additionalProperties": false, "properties": {"A2": {"type": "object", "required": ["words", "light", "tiles", "distract"], "additionalProperties": false, "properties": {"words": {"type": "array", "items": {"type": "string"}}, "light": {"type": "array", "items": {"type": "string"}}, "tiles": {"type": "object", "required": ["pre", "suf"], "additionalProperties": false, "properties": {"pre": {"type": "array", "items": {"type": "string"}}, "suf": {"type": "array", "items": {"type": "string"}}}}, "distract": {"type": "array", "items": {"type": "object", "required": ["pre", "is"], "additionalProperties": false, "properties": {"pre": {"type": "string"}, "is": {"enum": ["none", "extra"]}}}}}}, "B1": {"type": "object", "required": ["words", "light", "tiles", "distract"], "additionalProperties": false, "properties": {"words": {"type": "array", "items": {"type": "string"}}, "light": {"type": "array", "items": {"type": "string"}}, "tiles": {"type": "object", "required": ["pre", "suf"], "additionalProperties": false, "properties": {"pre": {"type": "array", "items": {"type": "string"}}, "suf": {"type": "array", "items": {"type": "string"}}}}, "distract": {"type": "array", "items": {"type": "object", "required": ["pre", "is"], "additionalProperties": false, "properties": {"pre": {"type": "string"}, "is": {"enum": ["none", "extra"]}}}}}}, "B2": {"type": "object", "required": ["words", "light", "tiles", "distract"], "additionalProperties": false, "properties": {"words": {"type": "array", "items": {"type": "string"}}, "light": {"type": "array", "items": {"type": "string"}}, "tiles": {"type": "object", "required": ["pre", "suf"], "additionalProperties": false, "properties": {"pre": {"type": "array", "items": {"type": "string"}}, "suf": {"type": "array", "items": {"type": "string"}}}}, "distract": {"type": "array", "items": {"type": "object", "required": ["pre", "is"], "additionalProperties": false, "properties": {"pre": {"type": "string"}, "is": {"enum": ["none", "extra"]}}}}}}}}, "none": {"type": "array", "items": {"type": "object", "required": ["key", "word", "chk"], "additionalProperties": false, "properties": {"key": {"type": "string"}, "word": {"type": "string", "pattern": "^[A-Za-zÄÖÜäöüß]+$"}, "chk": {"type": "object", "required": ["dwds", "wf", "hits"], "additionalProperties": false, "properties": {"dwds": {"const": false}, "wf": {"const": 0}, "hits": {"type": "integer", "minimum": 0, "maximum": 10}}}}}}, "rare": {"type": "array", "items": {"type": "object", "required": ["key", "word", "why"], "additionalProperties": false, "properties": {"key": {"type": "string"}, "word": {"type": "string", "pattern": "^[A-Za-zÄÖÜäöüß]+$"}, "en": {"$ref": "#/$defs/text"}, "why": {"$ref": "#/$defs/text"}}}}, "reviewedBy": {"type": "string", "minLength": 1}, "reviewedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}
}
