{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "igloo-lang@1",
  "title": "Igloo language file",
  "description": "One language's forms for every framework item, plus scenarios. tools/validate.py checks it against the framework.",
  "type": "object",
  "required": [
    "lang",
    "name",
    "items",
    "scenarios"
  ],
  "properties": {
    "lang": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "native": {
      "type": "string"
    },
    "notes": {
      "type": "object"
    },
    "turnGrid": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "gloss": {
            "type": "string"
          },
          "example": {
            "type": "object"
          },
          "note": {
            "type": "string"
          },
          "star": {
            "type": "boolean"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "model"
        ]
      }
    }
  }
}
