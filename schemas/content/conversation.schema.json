{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conversation@1",
  "title": "Conversation practice: topics and role-play scenarios of one language",
  "description": "Round 4 (lane L4). content/conversation/<lang>.json, manifest id conversation.<lang> in pack <lang>, named by the pack's content.conversation. Topics are for free chat: the title in the language (de) and in English (en), the level a learner should have (lv) and English tags the interests he types are matched against. Scenarios are role-plays built on the speaking situations' functions (fn): the title in the language and in English, the register (du or sie), and the English instructions the partner's prompt is filled with (role, setup, goal, opener). Ids are kebab-case and never a card-id shape.",
  "type": "object",
  "required": ["lang", "topics", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "lang": { "type": "string", "pattern": "^[a-z]{2,3}$" },
    "about": { "type": "string" },
    "reviewedBy": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "topics": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "de", "en", "lv", "tags"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "de": { "type": "string", "minLength": 2, "maxLength": 80 },
          "en": { "type": "string", "minLength": 2, "maxLength": 80 },
          "lv": { "enum": ["A1", "A2", "B1", "B2", "C1"] },
          "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z -]*$" } }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "en", "fn", "reg", "lv", "role", "setup", "goal", "opener"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 2, "maxLength": 80 },
          "en": { "type": "string", "minLength": 2, "maxLength": 80 },
          "fn": { "type": "string", "pattern": "^[a-z]+$" },
          "reg": { "enum": ["du", "sie"] },
          "lv": { "enum": ["A1", "A2", "B1", "B2", "C1"] },
          "role": { "type": "string", "minLength": 4, "maxLength": 200 },
          "setup": { "type": "string", "minLength": 4, "maxLength": 300 },
          "goal": { "type": "string", "minLength": 4, "maxLength": 200 },
          "opener": { "type": "string", "minLength": 4, "maxLength": 200 }
        }
      }
    }
  }
}
