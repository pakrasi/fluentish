{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "igloo-sentences-en@1",
  "title": "Sentence bank (English master)",
  "description": "Meanings, roles and English variants that every language's sentence file follows.",
  "type": "object",
  "required": [
    "roles",
    "meanings"
  ],
  "properties": {
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "meanings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "variants"
        ]
      }
    }
  }
}
