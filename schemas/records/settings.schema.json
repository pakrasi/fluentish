{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settings@1",
  "title": "Profile settings",
  "description": "Profile-scoped and synced: the goal and practice options. courses (round 3) holds one course per language and activeCourse names the one the app is about; language, level and exam (type, date) are the active course's mirror, written only through data/settings.js setCourse(). The active course's goal.date is the single source of the exam date (core/clock.js reads it through data/settings.js examDate). Merged per field, last write wins on the hybrid logical clock in rev (course fields under 'courses.<id>.<field>'). Round 4 (C0) adds optional fields: course goal.level, goal.by and week, practice.readNew and readMin, conversation, connections. A course keeps fields this build does not know (data/settings.js courseList), so an older device never drops them.",
  "type": "object",
  "required": [
    "v",
    "language",
    "level",
    "exam",
    "minutesPerDay"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z]+$"
    },
    "level": {
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        null
      ]
    },
    "exam": {
      "type": "object",
      "required": [
        "type",
        "date",
        "modules"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": [
            "string",
            "null"
          ],
          "description": "an exam id from the content manifest (e.g. goethe-b1), 'other', or null for no exam"
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "lesen",
              "hoeren",
              "schreiben",
              "sprechen"
            ]
          }
        },
        "result": {
          "type": [
            "object",
            "null"
          ],
          "description": "optional, after the exam: how it went"
        }
      }
    },
    "minutesPerDay": {
      "type": "integer",
      "minimum": 5,
      "maximum": 240
    },
    "newPerDay": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 200,
      "description": "null = automatic"
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readAloud": {
          "type": "boolean"
        },
        "claudeCheck": {
          "type": "boolean"
        },
        "simpleInput": {
          "type": "boolean"
        },
        "buildNew": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Word building: new cards a day (its own cap; default 5 when missing)"
        },
        "readNew": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Reading: new words a day from saved reading words (default 6 when missing; round 4)"
        },
        "readMin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120,
          "description": "Reading: minutes of the Read slot (default 10 when missing; round 4)"
        }
      }
    },
    "onboarded": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "courses": {
      "type": "array",
      "description": "one course per language, ordered by id. Added in round 3 (Arch #11): a record from before has none and gains course 'de' from language, level and exam (data/session.js migrateCourses)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "lang",
          "level",
          "goal",
          "decks"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "the course id: the language's short code for its first course ('de')"
          },
          "lang": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$",
            "description": "short language code ('de', 'fr')"
          },
          "level": {
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "C1",
              null
            ]
          },
          "goal": {
            "type": "object",
            "required": [
              "exam",
              "date"
            ],
            "additionalProperties": false,
            "properties": {
              "exam": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "an exam id from the content manifest (goethe-b1), 'other', or null"
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date",
                "description": "the exam date of this course; the active course's is the exam date"
              },
              "level": {
                "enum": [
                  "A1",
                  "A2",
                  "B1",
                  "B2",
                  "C1",
                  null
                ],
                "description": "the level he works towards (round 4, optional; missing means no level goal)"
              },
              "by": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                "description": "an optional month for the level goal ('YYYY-MM'; round 4)"
              }
            }
          },
          "decks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^([a-z0-9]+|[a-z]{2,3}:[a-z0-9][a-z0-9._-]*)$"
            },
            "description": "the course's decks: legacy names (b1, speak, script, clusters, build) for German, '<lang>:<name>' for any new deck (domain/decks.js)"
          },
          "week": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "min",
              "kind"
            ],
            "description": "the week plan, Monday first (round 4, optional; domain/week.js). Missing or null: every day is Normal with minutesPerDay",
            "properties": {
              "min": {
                "type": "array",
                "minItems": 7,
                "maxItems": 7,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 240
                }
              },
              "kind": {
                "type": "array",
                "minItems": 7,
                "maxItems": 7,
                "items": {
                  "enum": [
                    "n",
                    "light",
                    "read",
                    "write",
                    "talk",
                    "off"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "activeCourse": {
      "type": [
        "string",
        "null"
      ],
      "description": "the id of the course Today, Practice and the clock follow; null before onboarding"
    },
    "rev": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d{13}-\\d{4}-[\\w-]+$"
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Conversation practice options (round 4, optional; written only through data/settings.js). A record without it uses the defaults.",
      "properties": {
        "interests": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "description": "topics he typed, for free chat suggestions"
        },
        "perWeek": {
          "enum": [
            0,
            2,
            3
          ]
        },
        "readAloud": {
          "type": "boolean"
        },
        "showRecasts": {
          "type": "boolean"
        },
        "input": {
          "enum": [
            "voice",
            "typing"
          ]
        },
        "backupDefault": {
          "type": "boolean",
          "description": "whether a new session is backed up by default (transcripts are device-only unless he opts in)"
        },
        "keepDays": {
          "enum": [
            30,
            90,
            null
          ],
          "description": "days a transcript is kept on the device; null keeps it"
        },
        "monthlyCapUsd": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "connections": {
      "type": "object",
      "additionalProperties": false,
      "description": "Outside data he connects (round 4, optional). Repository names live here, never in code. results (docs/SHARING.md): the private GitHub repository the results sync, the progress backup and restore use; null or missing for a local-only profile. The owner's devices get theirs from a one-time migration (src/data/connection.js).",
      "properties": {
        "results": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9_.-]{1,100}$",
          "description": "the profile's results repository, owner/name"
        },
        "hours": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "repo",
            "path"
          ],
          "description": "study hours from a JSON file (hours-json@1), shown apart from app minutes",
          "properties": {
            "repo": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "lang": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z][a-z_-]{1,31}$",
              "description": "the project name in the file (german), or a language code"
            }
          }
        }
      }
    }
  }
}
